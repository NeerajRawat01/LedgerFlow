APP_ENV=development
BACKEND_PORT=8000
FRONTEND_PORT=3000

POSTGRES_DB=ledgerflow
POSTGRES_USER=ledgerflow
POSTGRES_PASSWORD=change_me

GEMINI_API_KEY=
GROQ_API_KEY=
# LLM provider selection: gemini (default) or groq.
# LLM_API_KEY is the neutral key; if unset, the provider-specific key above
# (GEMINI_API_KEY / GROQ_API_KEY) is used instead.
LLM_PROVIDER=
LLM_API_KEY=
MCP_SERVER_URL=http://127.0.0.1:8000/mcp
MCP_TIMEOUT_SECONDS=30
AGENT_MAX_TOOL_CALLS=25
AGENT_MAX_GRAPH_STEPS=50
LLM_MODEL=
